rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participantUids;
    }

    function isCallParticipant(callId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantUids;
    }

    function isConnectionParticipant(connectionId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/connections/$(connectionId)).data.participantUids;
    }

    function isBlocked(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/blocks/$(blockerUid + "_" + blockedUid));
    }

    function isBlockedBetween(firstUid, secondUid) {
      return isBlocked(firstUid, secondUid) || isBlocked(secondUid, firstUid);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /callCodes/{callCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /connections/{connectionId} {
      allow read: if isParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() == 2
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids[0] != request.resource.data.participantUids[1]
        && !isBlockedBetween(
          request.resource.data.participantUids[0],
          request.resource.data.participantUids[1]
        );
      allow update: if isParticipant(resource.data)
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if isParticipant(resource.data);
    }

    match /conversations/{connectionId} {
      allow read: if isConnectionParticipant(connectionId);
      allow create, update: if isConnectionParticipant(connectionId)
        && request.resource.data.participantUids
          == get(/databases/$(database)/documents/connections/$(connectionId)).data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConnectionParticipant(connectionId);
        allow create: if isConnectionParticipant(connectionId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.receiverUid is string
          && request.resource.data.receiverUid != request.auth.uid
          && request.resource.data.receiverUid in get(/databases/$(database)/documents/connections/$(connectionId)).data.participantUids
          && !isBlockedBetween(request.auth.uid, request.resource.data.receiverUid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if isConnectionParticipant(connectionId)
          && resource.data.receiverUid == request.auth.uid
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.receiverUid == resource.data.receiverUid
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow delete: if false;
      }
    }

    match /phoneDirectory/{phoneHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneLast4 is string;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /devices/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /calls/{callId} {
      allow create: if signedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.participantUids == [request.auth.uid, request.resource.data.calleeUid]
        && request.resource.data.status == 'ringing'
        && request.resource.data.roomName is string
        && !isBlockedBetween(request.auth.uid, request.resource.data.calleeUid);

      allow read: if isParticipant(resource.data);

      allow update: if isParticipant(resource.data)
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.participantUids == resource.data.participantUids
        && request.resource.data.roomName == resource.data.roomName
        && request.resource.data.video == resource.data.video
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'endedAt', 'updatedAt'])
        && (
          (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status in ['accepted', 'declined', 'busy'])
          || (request.auth.uid == resource.data.callerUid
            && resource.data.status == 'ringing'
            && request.resource.data.status in ['ended', 'missed'])
          || (resource.data.status == 'accepted'
            && request.resource.data.status == 'ended')
        );

      allow delete: if false;
    }

    match /calls/{callId}/webrtc/{signalId} {
      allow read, create, update, delete: if isCallParticipant(callId);
    }

    match /calls/{callId}/iceCandidates/{candidateId} {
      allow read, create, update, delete: if isCallParticipant(callId);
    }

    match /blocks/{blockId} {
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.auth.uid + "_" + request.resource.data.blockedUid;
      allow read, delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
